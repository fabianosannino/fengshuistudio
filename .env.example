# ============================================================
# FengShui Studio — variáveis de ambiente
# Copie para .env.local (gitignored) e preencha. NUNCA versione valores.
# ============================================================

# --- Supabase ------------------------------------------------
# Painel > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço (ignora RLS). SOMENTE no servidor — sem NEXT_PUBLIC_.
# Usada pelos webhooks do Stripe e pela ativação de planos.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe --------------------------------------------------
# Dashboard > Developers > API keys
STRIPE_SECRET_KEY=
# Webhook /api/stripe/webhooks (eventos de contas conectadas)
STRIPE_WEBHOOK_SECRET=
# Webhook /api/stripe/webhooks/subscriptions (assinaturas da plataforma)
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=
# Prices dos planos da plataforma (Dashboard > Products)
STRIPE_PRICE_ID=
STRIPE_PRICE_SIMPLES_MONTHLY=
STRIPE_PRICE_SIMPLES_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# --- App -----------------------------------------------------
# URL pública do app (fallback de origin em redirects do Stripe)
NEXT_PUBLIC_APP_URL=

# --- Rate limit compartilhado (Upstash Redis) ------------------
# SOMENTE no servidor — sem NEXT_PUBLIC_. Sem estas duas, o limitador conta em
# memória, ou seja, por instância serverless: um limite de 10 vira "10 por
# instância" e não segura força bruta de chave de ativação. Sem elas o app
# funciona normalmente e a rota `rate-limit` registra um warn em produção.
# Console: console.upstash.com > Redis > REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Analytics (opcionais) -----------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Google Maps (opcional) ------------------------------------
# Habilita o Modo C de orientação (alinhar a planta sobre satélite,
# app/components/MapaAlinhamento.tsx). Sem esta chave, o Modo C fica
# oculto/desabilitado — não quebra o app. Crie em console.cloud.google.com,
# ative "Maps JavaScript API" + "Geocoding API", e RESTRINJA a chave por
# domínio HTTP referrer (é uma chave pública, exposta ao navegador).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Segredo do agendador da Vercel, para /api/admin/reconciliacao.
# Sem ele, a rota só aceita sessão de admin.
CRON_SECRET=
